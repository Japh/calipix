// What ImageJ displays for each pixel type under several display ranges and lookup tables.
// Each case builds a fresh one-row image, sets the LUT and display range, converts the image
// to RGB (which captures exactly what the screen shows) and dumps the packed 0xRRGGBB values.
// Test images (regenerated by the Rust tests):
//   u8   256x1  v = x
//   u16  512x1  v = 500 + (x*37) mod 4000
//   f32  256x1  v = (float)((x-100.25)*0.375)
//   f32s as f32, with NaN at x=3, +Infinity at x=200 and -Infinity at x=10
//   rgb  256x1  r = x, g = 255-x, b = (x*7) mod 256   (display range applied to all channels)
//   rgb4 as rgb, display range applied to the red channel only (setMinAndMax(min, max, 4))
// Outputs:
//   display_levels.csv   kind,lut,inverted,min,max,<one packed RGB value per pixel>
//                        min = "auto" means resetMinAndMax() (the default display range)
d = getArgument();
s = "";
luts = newArray("Grays", "Fire");
// 8-bit: ByteProcessor.setMinAndMax rescales the LUT
r8 = newArray("auto","auto", "0","255", "50","200", "100","100", "10.4","99.6", "10.5","99.5", "200","255", "0","1", "37","38", "0","0", "255","255", "-20","300", "128","511", "0.5","254.5");
for (i=0; i<r8.length; i+=2) s = s + row("u8", "Grays", 0, r8[i], r8[i+1]);
s = s + row("u8", "Fire", 0, "50", "200");
s = s + row("u8", "Grays", 1, "50", "200");
s = s + row("u8", "Ice", 1, "auto", "auto");
// 16-bit: ShortProcessor.create8BitImage
r16 = newArray("auto","auto", "0","65535", "1000","1255", "1000","1254", "1000.5","3000.49", "999.5","3000.5", "600","600", "2000","70000", "0","0", "4499","4500", "500","4499", "0","100");
for (i=0; i<r16.length; i+=2) s = s + row("u16", "Grays", 0, r16[i], r16[i+1]);
s = s + row("u16", "Fire", 0, "1000", "3000");
s = s + row("u16", "Spectrum", 1, "auto", "auto");
// float: FloatProcessor.create8BitImage
r32 = newArray("auto","auto", "0","1", "-10","10", "0.1","0.7", "5","5", "-37.59375","58.03125", "-100","200", "0","0", "20","58.03125");
for (i=0; i<r32.length; i+=2) s = s + row("f32", "Grays", 0, r32[i], r32[i+1]);
s = s + row("f32", "Ice", 0, "-10", "30");
s = s + row("f32", "Grays", 1, "-10", "30");
rs = newArray("auto","auto", "-10","10", "0","1");
for (i=0; i<rs.length; i+=2) s = s + row("f32s", "Grays", 0, rs[i], rs[i+1]);
// RGB: ColorProcessor.setMinAndMax changes the pixels themselves
rc = newArray("0","255", "50","200", "40.7","180.2", "100","100", "0","127", "128","255", "-30","400", "0.9","254.9");
for (i=0; i<rc.length; i+=2) s = s + row("rgb", "Grays", 0, rc[i], rc[i+1]);
s = s + row("rgb4", "Grays", 0, "50", "200");
File.saveString(s, d+"/display_levels.csv");
print("GEN_OK");

function make(kind) {
	if (kind=="u8") {
		newImage("i", "8-bit black", 256, 1, 1);
		for (x=0; x<256; x++) setPixel(x, 0, x);
	} else if (kind=="u16") {
		newImage("i", "16-bit black", 512, 1, 1);
		for (x=0; x<512; x++) setPixel(x, 0, 500 + (x*37)%4000);
	} else if (kind=="f32" || kind=="f32s") {
		newImage("i", "32-bit black", 256, 1, 1);
		for (x=0; x<256; x++) setPixel(x, 0, (x-100.25)*0.375);
		if (kind=="f32s") {
			setPixel(3, 0, NaN); setPixel(200, 0, 1/0); setPixel(10, 0, -1/0);
		}
	} else {
		newImage("i", "RGB black", 256, 1, 1);
		for (x=0; x<256; x++) setPixel(x, 0, (x<<16) | ((255-x)<<8) | ((x*7)%256));
	}
	updateDisplay();
}

function row(kind, lut, inv, minS, maxS) {
	make(kind);
	if (lut!="Grays") run(lut);
	if (inv==1) run("Invert LUT");
	if (minS=="auto") resetMinAndMax();
	else if (kind=="rgb4") setMinAndMax(parseFloat(minS), parseFloat(maxS), 4);
	else setMinAndMax(parseFloat(minS), parseFloat(maxS));
	if (bitDepth()!=24) run("RGB Color");
	line = kind + "," + lut + "," + inv + "," + minS + "," + maxS;
	w = getWidth();
	for (x=0; x<w; x++) line = line + "," + (getPixel(x, 0)&0xffffff);
	close();
	return line + "\n";
}
