// Multi-channel display: what ImageJ's CompositeImage shows in composite, color and grayscale
// modes, with per-channel lookup tables, display ranges and channel visibility.
// Test images, 16x8 with 3 channels (c = 1..3; regenerated by the Rust tests):
//   8-bit  v = (x*16 + y*c*5 + c*40) mod 256
//   16-bit v = (x*4099 + y*523*c + c*7001) mod 65536
// Outputs:
//   composite.csv   type,case,<one packed 0xRRGGBB value per pixel, row-major>
// Cases (display ranges are always set explicitly for 16-bit):
//   default   red, green, blue LUTs; 8-bit ranges 0-255; 16-bit ranges (0,65535) (5000,40000) (20000,20255)
//   luts      as default with LUTs Fire, Cyan, Yellow (sums saturate)
//   ranges    as default with 8-bit ranges (20,200) (0,100) (100.4,180.6)
//   active101 / active011 / active110 / active000   as luts, with only some channels visible
//   color2    as luts, display mode "color", channel 2 selected
//   gray3     as luts, display mode "grayscale", channel 3 selected
//   max / min as luts, with the CompositeProjection property set to Max / Min
d = getArgument();
types = newArray("8-bit", "16-bit");
cases = newArray("default", "luts", "ranges", "active101", "active011", "active110", "active000", "color2", "gray3", "max", "min");
s = "";
for (t=0; t<types.length; t++) {
	for (k=0; k<cases.length; k++)
		s = s + row(types[t], cases[k]);
}
File.saveString(s, d+"/composite.csv");
print("GEN_OK");

function row(type, name) {
	newImage("c", type+" composite-mode", 16, 8, 3, 1, 1);
	for (c=1; c<=3; c++) {
		Stack.setChannel(c);
		for (y=0; y<8; y++) for (x=0; x<16; x++) {
			if (type=="8-bit") setPixel(x, y, (x*16 + y*c*5 + c*40)%256);
			else setPixel(x, y, (x*4099 + y*523*c + c*7001)%65536);
		}
	}
	if (name!="default" && name!="ranges") {
		Stack.setChannel(1); run("Fire");
		Stack.setChannel(2); run("Cyan");
		Stack.setChannel(3); run("Yellow");
	}
	if (type=="16-bit") {
		Stack.setChannel(1); setMinAndMax(0, 65535);
		Stack.setChannel(2); setMinAndMax(5000, 40000);
		Stack.setChannel(3); setMinAndMax(20000, 20255);
	} else if (name=="ranges") {
		Stack.setChannel(1); setMinAndMax(20, 200);
		Stack.setChannel(2); setMinAndMax(0, 100);
		Stack.setChannel(3); setMinAndMax(100.4, 180.6);
	}
	Stack.setChannel(1);
	if (startsWith(name, "active")) Stack.setActiveChannels(substring(name, 6));
	if (name=="color2") { Stack.setDisplayMode("color"); Stack.setChannel(2); }
	if (name=="gray3") { Stack.setDisplayMode("grayscale"); Stack.setChannel(3); }
	if (name=="max") Property.set("CompositeProjection", "Max");
	if (name=="min") Property.set("CompositeProjection", "Min");
	updateDisplay();
	run("RGB Color");
	if (bitDepth()!=24) exit("RGB conversion did not produce an RGB image");
	line = type + "," + name;
	for (y=0; y<8; y++) for (x=0; x<16; x++) line = line + "," + (getPixel(x, y)&0xffffff);
	run("Close All");
	return line + "\n";
}
